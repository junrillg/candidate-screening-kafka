flowchart TB
    subgraph Browser["PLANNED · synthetic browser"]
        UI["1 · React form"]
        P["2b · Processing<br/>navigation available"]
        R["8 · Authorized result<br/>or explicit notice link"]
    end
    subgraph Business["PLANNED · small local Compose deployment"]
        API["2 · Candidates API"]

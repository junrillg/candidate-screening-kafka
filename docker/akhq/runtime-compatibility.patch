+import org.apache.kafka.clients.admin.GroupListing;
+import org.apache.kafka.clients.admin.ListGroupsOptions;
+import org.apache.kafka.clients.admin.ListGroupsResult;
+import org.apache.kafka.common.GroupState;
+import org.apache.kafka.common.GroupType;
+import org.apache.kafka.common.KafkaFuture;
+import org.apache.kafka.common.errors.ClusterAuthorizationException;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.mockito.MockMakers;
+
+import java.lang.reflect.Field;
+import java.util.Collection;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ExecutionException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.withSettings;
+
+class KafkaCompatibilityTest {
+    @Test
+    void preservesClassicConsumerAndEmptyGroupIdsWithProtocolOnlyOptions() throws Exception {
+        List<GroupListing> groups = List.of(
+            new GroupListing("classic", Optional.of(GroupType.CLASSIC), "consumer", Optional.of(GroupState.STABLE)),
+            new GroupListing("consumer", Optional.of(GroupType.CONSUMER), "consumer", Optional.of(GroupState.STABLE)),
+            new GroupListing("empty", Optional.of(GroupType.CLASSIC), "", Optional.of(GroupState.EMPTY)));
+        AdminClient admin = subclassMock(AdminClient.class);
+        ListGroupsResult result = subclassMock(ListGroupsResult.class);
+        when(result.all()).thenReturn(KafkaFuture.<Collection<GroupListing>>completedFuture(groups));
+        when(admin.listGroups(any(ListGroupsOptions.class))).thenReturn(result);
+        AbstractKafkaWrapper wrapper = wrapper(admin);
+
+        assertEquals(List.of("classic", "consumer", "empty"),
+            wrapper.listConsumerGroups("fixture").stream().map(GroupListing::groupId).toList());
+        assertSame(groups, wrapper.listConsumerGroups("fixture"));
+        ArgumentCaptor<ListGroupsOptions> options = ArgumentCaptor.forClass(ListGroupsOptions.class);
+        verify(admin, times(1)).listGroups(options.capture());
+        assertEquals(Set.of("", "consumer"), options.getValue().protocolTypes());
+        assertTrue(options.getValue().types().isEmpty());
+        assertTrue(options.getValue().groupStates().isEmpty());
+        assertNull(options.getValue().timeoutMs());
+    }
+
+    @Test
+    void cachesSuccessfulEmptyCollectionWithoutRefetching() throws Exception {
+        AdminClient admin = subclassMock(AdminClient.class);
+        ListGroupsResult result = subclassMock(ListGroupsResult.class);
+        when(result.all()).thenReturn(KafkaFuture.<Collection<GroupListing>>completedFuture(List.of()));
+        when(admin.listGroups(any(ListGroupsOptions.class))).thenReturn(result);
+        AbstractKafkaWrapper wrapper = wrapper(admin);
+
+        assertTrue(wrapper.listConsumerGroups("fixture").isEmpty());
+        assertTrue(wrapper.listConsumerGroups("fixture").isEmpty());
+        verify(admin, times(1)).listGroups(any(ListGroupsOptions.class));
+    }
+
+    @Test
+    void propagatesAllFutureFailureWithoutCachingPartialOrEmptyResults() throws Exception {
+        AdminClient admin = subclassMock(AdminClient.class);
+        ListGroupsResult result = subclassMock(ListGroupsResult.class);
+        KafkaFuture<Collection<GroupListing>> future = mock(withSettings().mockMaker(MockMakers.SUBCLASS));
+        ExecutionException failure = new ExecutionException(new IllegalStateException("fixture failure"));
+        when(future.get()).thenThrow(failure);
+        when(result.all()).thenReturn(future);
+        when(admin.listGroups(any(ListGroupsOptions.class))).thenReturn(result);
+        AbstractKafkaWrapper wrapper = wrapper(admin);
+
+        assertSame(failure, assertThrows(ExecutionException.class, () -> wrapper.listConsumerGroups("fixture")));
+        assertSame(failure, assertThrows(ExecutionException.class, () -> wrapper.listConsumerGroups("fixture")));
+        verify(admin, times(2)).listGroups(any(ListGroupsOptions.class));
+        verify(result, never()).valid();
+        ClusterAuthorizationException denied = new ClusterAuthorizationException("fixture denied");
+        when(future.get()).thenThrow(new ExecutionException(denied));
+        assertSame(denied, assertThrows(ClusterAuthorizationException.class, () -> wrapper.listConsumerGroups("fixture")));
+    }
+
+    @Test
+    void keepsRepositorySearchAuthorizationRegexSortAndCount() throws Exception {
+        AbstractKafkaWrapper wrapper = subclassMock(AbstractKafkaWrapper.class);
+        when(wrapper.listConsumerGroups("fixture")).thenReturn(List.of(
+            new GroupListing("visible-Z", Optional.empty(), "consumer", Optional.empty()),
+            new GroupListing("hidden-a", Optional.empty(), "consumer", Optional.empty()),
+            new GroupListing("visible-a", Optional.empty(), "", Optional.of(GroupState.EMPTY))));
+        ConsumerGroupRepository repository = new ConsumerGroupRepository();
+        setField(ConsumerGroupRepository.class, repository, "kafkaWrapper", wrapper);
+
+        assertEquals(List.of("visible-a", "visible-Z"),
+            repository.all("fixture", Optional.of("VISIBLE"), List.of("visible-.*")));
+        assertEquals(2, repository.all("fixture", Optional.empty(), List.of("visible-.*")).size());
+        assertTrue(repository.all("fixture", Optional.of("missing"), List.of("visible-.*")).isEmpty());
+        ExecutionException failure = new ExecutionException(new IllegalStateException("fixture failure"));
+        when(wrapper.listConsumerGroups("fixture")).thenThrow(failure);
+        assertSame(failure, assertThrows(RuntimeException.class, () ->
+            repository.all("fixture", Optional.empty(), List.of("visible-.*"))).getCause());
+    }
+
+    @Test
+    void preservesExactOidcUsernameClaimDefault() {
+        assertEquals("preferred_username", ProfileClaims.CLAIM_PREFERRED_USERNAME);
+        assertEquals(ProfileClaims.CLAIM_PREFERRED_USERNAME, new Oidc.Provider().getUsernameField());
+    }
+
+    private static AbstractKafkaWrapper wrapper(AdminClient admin) throws Exception {
+        KafkaModule module = subclassMock(KafkaModule.class);
+        when(module.getAdminClient("fixture")).thenReturn(admin);
+        AbstractKafkaWrapper wrapper = new AbstractKafkaWrapper() { };
+        setField(AbstractKafkaWrapper.class, wrapper, "kafkaModule", module);
+        return wrapper;
+    }
+
+    private static <T> T subclassMock(Class<T> type) {
+        // Existing Mockito's supported subclass maker needs no dynamic JVM agent.
+        return mock(type, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+
+    private static void setField(Class<?> owner, Object object, String name, Object value) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(object, value);
+    }
+}

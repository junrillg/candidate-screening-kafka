+package org.akhq.compatibility;
+
+import com.amazonaws.services.schemaregistry.serializers.json.JsonSerializer;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.node.NullNode;
+import io.confluent.kafka.schemaregistry.json.JsonSchema;
+import io.confluent.kafka.schemaregistry.json.JsonSchemaUtils;
+import io.confluent.kafka.schemaregistry.protobuf.ProtobufSchema;
+import jakarta.activation.CommandMap;
+import jakarta.activation.DataHandler;
+import jakarta.activation.MimetypesFileTypeMap;
+import jakarta.activation.spi.MailcapRegistryProvider;
+import jakarta.activation.spi.MimeTypeRegistryProvider;
+import net.jpountz.lz4.LZ4Factory;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.ServiceLoader;
+import java.util.concurrent.ExecutorService;
+
+/** Fixed local-only packaged-JAR fixture. It creates no sockets, cloud clients or credential providers. */
+public final class DerivativeRuntimeProbe {
+    private DerivativeRuntimeProbe() { }
+
+    public static void main(String[] arguments) throws Exception {
+        require(arguments.length == 0, "Unexpected fixture arguments.");
+        ObjectMapper mapper = new ObjectMapper();
+        Fixture input = new Fixture();
+        JsonSerializer glue = new JsonSerializer(null);
+        require(mapper.readTree(glue.getSchemaDefinition(input)).path("properties").has("value"), "Glue schema missing field.");
+        require(mapper.readTree(glue.serialize(input)).equals(mapper.valueToTree(input)), "Glue JSON roundtrip changed data.");
+        JsonSchema confluent = JsonSchemaUtils.getSchema(input);
+        require(mapper.readTree(confluent.canonicalString()).path("properties").has("value"), "Confluent schema missing field.");
+        confluent.validate(mapper.valueToTree(input));
+        new JsonSchema("{\"type\":[\"string\",\"null\"]}").validate(NullNode.getInstance());
+        passed("Glue and Confluent JSON inference/validation and nullable JSON");
+
+        byte[] original = "local compression fixture local compression fixture".getBytes(StandardCharsets.UTF_8);
+        LZ4Factory lz4 = LZ4Factory.fastestJavaInstance();
+        byte[] compressed = lz4.fastCompressor().compress(original);
+        require(Arrays.equals(original, lz4.fastDecompressor().decompress(compressed, original.length)), "LZ4 roundtrip changed data.");
+        passed("selected LZ4 Java compression roundtrip");
+
+        ProtobufSchema protobuf = new ProtobufSchema(
+            "syntax = \"proto3\"; import \"google/protobuf/any.proto\"; message Fixture { google.protobuf.Any value = 1; }");
+        require(protobuf.toDescriptor().findFieldByName("value").getMessageType().getFullName().equals("google.protobuf.Any"),
+            "Protobuf built-in resolution changed.");
+        passed("selected Protobuf definition parse and built-in resolution");
+
+        require(ServiceLoader.load(MailcapRegistryProvider.class).stream().anyMatch(provider ->
+            provider.type().getName().equals("org.eclipse.angus.activation.MailcapRegistryProviderImpl")), "Angus mailcap provider missing.");
+        require(ServiceLoader.load(MimeTypeRegistryProvider.class).stream().anyMatch(provider ->
+            provider.type().getName().equals("org.eclipse.angus.activation.MimeTypeRegistryProviderImpl")), "Angus MIME provider missing.");
+        require(new MimetypesFileTypeMap().getContentType("fixture.txt").equals("text/plain"), "MIME lookup changed.");
+        require(new DataHandler("fixture", "text/plain").getContent().equals("fixture"), "DataHandler changed content.");
+        require(CommandMap.getDefaultCommandMap().getMimeTypes() != null, "Mailcap registry unavailable.");
+        passed("Activation SPI/MIME/DataHandler local compatibility");
+
+        require(System.getProperty("os.name").equals("Linux"), "Selected fixture requires Linux.");
+        Class<?> factory = Class.forName("io.spiffe.workloadapi.internal.GrpcManagedChannelFactory");
+        require(factory.getDeclaredMethod("newChannel", URI.class, ExecutorService.class) != null, "Linux SPIFFE adapter linkage missing.");
+        requireNativeStack("io.grpc.netty.shaded");
+        requireNativeStack("io.confluent.scp.shaded.io.grpc.netty.shaded");
+        passed("both exact native namespaces and their own gRPC TLS context factories");
+        System.out.println("PASS fixed local packaged compatibility probe; no FAAS/cloud integration claim");
+    }
+
+    private static void requireNativeStack(String prefix) throws Exception {
+        Class<?> epoll = Class.forName(prefix + ".io.netty.channel.epoll.Epoll");
+        if (!(boolean) epoll.getMethod("isAvailable").invoke(null)) {
+            Throwable cause = (Throwable) epoll.getMethod("unavailabilityCause").invoke(null);
+            throw new IllegalStateException("Required Linux native epoll unavailable: " + prefix, cause);
+        }
+        // Use this actual gRPC namespace's supported TLS factory, not an unrelated SSLContext.
+        Object builder = Class.forName(prefix + ".io.grpc.netty.GrpcSslContexts")
+            .getMethod("forClient").invoke(null);
+        Object context = builder.getClass().getMethod("build").invoke(builder);
+        require(context != null, "gRPC TLS context unavailable: " + prefix);
+        System.out.println("PASS required epoll native: " + prefix + "; gRPC TLS context: " + context.getClass().getName());
+        Class.forName(prefix + ".io.netty.util.ReferenceCountUtil")
+            .getMethod("release", Object.class).invoke(null, context);
+    }
+
+    private static void require(boolean condition, String message) {
+        if (!condition) throw new IllegalStateException(message);
+    }
+
+    private static void passed(String name) {
+        System.out.println("PASS " + name);
+    }
+
+    public static final class Fixture {
+        public String value = "fixture";
+        public int count = 2;
+    }
+}
